# Copy to .env and fill in. Never commit .env.
#
# The app runs one way everywhere — there is no development mode and no
# production mode. Which database and storage it uses is decided by whether the
# credentials below are present, and the pipeline always runs inline.

# ── AI ──
ANTHROPIC_API_KEY=

# ── Auth ──
# The single shared password for the employee side. Required — the app refuses
# to start without it. No user directory, no sign-up.
# Generate with:  python -c "import secrets;print(secrets.token_urlsafe(18))"
APP_PASSWORD=

# ── Database ──
# Supabase -> Connect. If your network is IPv4-only use the Session pooler URI;
# it reaches the same database. Percent-encode @ : / ? in the password.
# Blank selects a local SQLite file, which is fine until you deploy.
DATABASE_URL=

# ── Storage ──
# Supabase -> Project Settings -> API Keys. Use the SECRET key (sb_secret_...),
# never the publishable one: a publishable key is subject to row-level security
# and cannot write to a private bucket. Both blank selects ./uploads.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=onboarding-documents

# ── Frontend ──
# Origins allowed to call /api from a browser. The deployed app serves the React
# bundle from the same origin, so this only matters for the Vite dev server.
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
